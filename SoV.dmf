		name = "C+UP"
		command = "Stop-Draw-Energy"
	elem 
		name = "C+REP"
		command = "Awaken-Energy"
	elem 
		name = "ALT+S"
		command = "Auto-Spawn"
	elem 
		name = "F1+REP"
		command = ".options"
	elem 
		name = "F2+REP"
		command = ".screenshot"


menu "menu"
	elem "connection_window"
		name = "Options"
		command = ""
		saved-params = "is-checked"
	elem 
		name = "Correct Resolution"
		command = ".winset \"mainwindow.map.icon-size=32\""
		category = "Options"
		saved-params = "is-checked"
	elem 
		name = "&Check Time"
		command = "checktime"
		category = "Options"
		saved-params = "is-checked"
	elem 
		name = "&Check Offline Gains"
		command = "checkofflinegains"
		category = "Options"
		saved-params = "is-checked"


