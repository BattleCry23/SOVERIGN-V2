		command = "TurnW"
	elem 
		name = "North+REP"
		command = ".north"
	elem 
		name = "CTRL+North+REP"
		command = "TurnN"
	elem 
		name = "East+REP"
		command = ".east"
	elem 
		name = "CTRL+East+REP"
		command = "TurnE"
	elem 
		name = "South+REP"
		command = ".south"
